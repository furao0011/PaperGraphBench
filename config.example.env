# Copy this file to config.env in the repository root. config.env is private.
# A pre-existing process environment variable takes priority over this file.
# Base URLs must be API roots (for example, ending in /v1), not endpoint URLs.

# Construction, question generation, and evaluation judge (OpenAI-compatible chat API).
API_KEY=
BASE_URL=
LLM_MODEL=

# Vision API for figures/tables. Required when MULTIMODAL_ENABLED=true.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Embedding API. Always required for graph construction; evaluation needs it
# only when CLAIM_VERIFY_ENABLED=true.
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# The model being evaluated (OpenAI-compatible chat API).
EVAL_TARGET_API_KEY=
EVAL_TARGET_BASE_URL=
EVAL_TARGET_MODEL=

# OCR service: fill these only when starting from PDF rather than parsed Markdown.
PADDLE_OCR_API_URL=
PADDLE_OCR_TOKEN=

# Formal pipeline defaults. Do not enable mock/offline modes for results.
USE_ONLINE_KC_EXTRACT=true
MULTIMODAL_ENABLED=true
MULTIMODAL_KC_ENABLED=true
USE_ONLINE_EVAL=true
PAPERGRAPH_PROGRESS=true
CLAIM_VERIFY_ENABLED=false
ALLOW_OFFLINE_FALLBACK=false
ALLOW_MOCK_EVAL=false

# Relative paths are resolved against the repository root.
PAPERGRAPH_DATA_ROOT=data
RAW_PAPER_ROOT=rawPaper
EVAL_RESULT_ROOT=outputs/evaluation
