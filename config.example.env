# ============================================================================
# REQUIRED BEFORE RUNNING / 运行前必须配置
# This repository does NOT include API access, keys, or free model services.
# 本仓库不提供 API 密钥或免费模型服务，运行者需自行提供可用的服务和额度。
# Copy to config.env (or run start.ps1/start.sh once), then fill ALL FOUR groups
# below for graph construction -> questions -> evaluation. Keep config.env private.
# 从建图运行到评测须填写下面全部四组：各自的 API_KEY、BASE_URL 和 MODEL。
# Existing-package evaluation only needs groups 1 + 4 (default settings).
# 仅评测已有数据包时，默认只需第 1、4 组；从 PDF 开始还需配置 OCR。
#
# BASE_URL = your provider's OpenAI-compatible API root (often ending in /v1),
# NOT a /chat/completions or /embeddings endpoint. MODEL = an exact model ID
# available to YOUR account, not a display name. Check your provider's API docs.
# BASE_URL 填服务商的 API 根地址，不填网页地址或具体接口；MODEL 填可调用的模型 ID。
# You may reuse one service/key for several groups, but explicitly fill each
# group's three fields. A process environment variable overrides config.env.
# 同一服务可复用地址和密钥，但每组仍须逐项填写；系统环境变量优先于本文件。
# ============================================================================

# 1. REQUIRED: Text model / 文本模型：建图、出题及评测 Judge
# Requires an OpenAI-compatible chat API with JSON response support.
API_KEY=
BASE_URL=
LLM_MODEL=

# 2. REQUIRED for building/questions: Vision model / 图表理解与多模态出题
# Must accept images through an OpenAI-compatible chat API.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# 3. REQUIRED for building: Embedding model / 建图所需向量模型
# Must provide the OpenAI-compatible embeddings API, not a chat-only model.
# Existing-package evaluation needs this only if CLAIM_VERIFY_ENABLED=true.
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# 4. REQUIRED for evaluation: Target model / 被测模型（不是 Judge）
# Must accept text AND images for the released multimodal question packages.
EVAL_TARGET_API_KEY=
EVAL_TARGET_BASE_URL=
EVAL_TARGET_MODEL=

# OPTIONAL: OCR service / 仅从 PDF 开始时填写；公开样例及已解析 Markdown 不需要
PADDLE_OCR_API_URL=
PADDLE_OCR_TOKEN=

# Formal pipeline defaults. Do not enable mock/offline modes for results.
USE_ONLINE_KC_EXTRACT=true
MULTIMODAL_ENABLED=true
MULTIMODAL_KC_ENABLED=true
USE_ONLINE_EVAL=true
PAPERGRAPH_PROGRESS=true
CLAIM_VERIFY_ENABLED=false
ALLOW_OFFLINE_FALLBACK=false
ALLOW_MOCK_EVAL=false

# Relative paths are resolved against the repository root.
PAPERGRAPH_DATA_ROOT=data
RAW_PAPER_ROOT=rawPaper
EVAL_RESULT_ROOT=outputs/evaluation
